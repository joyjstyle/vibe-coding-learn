{
  "name": "genie-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Genie Lab: Clinic Genie Vibe Coding Intern Platform",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "content": "node scripts/build-content.ts",
    "design-system": "node scripts/build-design-system.ts",
    "generate": "npm run --silent design-system && npm run --silent content",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate && node scripts/db-migrate.ts --if-configured",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.ts",
    "create-intern": "node scripts/create-intern.ts"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "lucide-react": "1.66.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
