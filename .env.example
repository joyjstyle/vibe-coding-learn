# Copy to .env.local for local work, or set these in your hosting provider. Never commit real values.

# Neon connection string. Use the pooled one (host ends in -pooler) for the running app.
# Without it, the app runs in local development mode with JSON files in .data/.
DATABASE_URL=

# A long random secret for signing sessions, for example from: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's public address, for example https://genie-lab.example.com
BETTER_AUTH_URL=

# Sign-in is on by default and each account's data is kept separately.
# Set to 0 to turn sign-in off so everyone shares one account.
# GENIE_LAB_LOGIN=0

# Development only. Never set these in production.
# GENIE_LAB_DEV=1
# GENIE_LAB_DEV_COHORT_START=2026-11-16
# GENIE_LAB_DEV_TODAY=2026-11-18
